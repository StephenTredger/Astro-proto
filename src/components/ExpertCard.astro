---
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { getInitials } from '../lib/initials';

interface Props {
  expert: CollectionEntry<'experts'>;
  href: string;
}

const { expert, href } = Astro.props;
const { Content } = await render(expert);

const initials = getInitials(expert.data.name);
---

<div class="rounded-lg border border-border bg-surface p-6">
  <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-background font-sans text-sm font-bold text-muted">
    {initials}
  </div>
  <p class="mb-1 font-sans text-base font-bold text-charcoal">{expert.data.name}</p>
  <p class="mb-3 text-sm text-muted">{expert.data.title}</p>
  <div class="mb-4 text-sm text-muted [&_p]:mb-0">
    <Content />
  </div>
  <div class="flex items-center justify-between gap-3">
    {expert.data.phone && (
      <a
        href={`tel:${expert.data.phone.replace(/[^\d+]/g, '')}`}
        class="flex items-center gap-1.5 text-sm font-semibold text-charcoal no-underline hover:text-accent"
      >
        <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"></path>
        </svg>
        {expert.data.phone}
      </a>
    )}
    <a href={href} class="text-sm font-semibold text-accent no-underline hover:underline">Visit profile &rarr;</a>
  </div>
</div>
