---
interface Props {
  code: string;
  name: string;
  count: number;
  href: string;
  colorClass: string;
}

const { code, name, count, href, colorClass } = Astro.props;
---

<a
  href={href}
  class="rounded-lg border border-border bg-surface p-4 no-underline transition-all hover:-translate-y-0.5 hover:border-accent hover:shadow-[0_4px_12px_rgba(0,0,0,0.08)]"
>
  <span class={`mb-3 inline-flex h-8 w-8 items-center justify-center rounded text-[11px] font-bold ${colorClass}`}>
    {code}
  </span>
  <span class="block font-sans text-[15px] font-bold text-charcoal">{name}</span>
  <span class="block text-sm text-muted">{count} answer{count === 1 ? '' : 's'}</span>
</a>
