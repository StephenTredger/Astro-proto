---
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

interface Props {
  expert: CollectionEntry<'experts'>;
  questionsAnswered: number;
}

const { expert, questionsAnswered } = Astro.props;
const { Content } = await render(expert);

const placeholderPattern = 'bg-[repeating-linear-gradient(45deg,#E4E8E2_0_10px,#EDEFEA_10px_20px)]';
const telHref = expert.data.phone ? `tel:${expert.data.phone.replace(/[^\d+]/g, '')}` : undefined;
---

<div
  id={expert.data.slug}
  class="scroll-mt-28 flex flex-col gap-6 rounded-lg border border-border bg-surface p-6 md:flex-row md:items-start"
>
  <span
    class={`flex h-20 w-20 shrink-0 items-center justify-center overflow-hidden rounded-full border border-border ${placeholderPattern}`}
  >
    <span class="rounded bg-white/80 px-1.5 py-0.5 font-mono text-[10px] text-muted">photo</span>
  </span>

  <div class="min-w-0 flex-1">
    <p class="m-0 font-sans text-lg font-bold text-charcoal">{expert.data.name}</p>
    <p class="m-0 mb-3 text-sm text-muted">{expert.data.title}, Spelsberg UK</p>
    <div class="mb-3 text-sm text-charcoal [&_p]:mb-0">
      <Content />
    </div>
    <div class="flex flex-wrap items-center gap-x-2 gap-y-1 text-[13px] text-muted">
      {questionsAnswered > 0 && (
        <span><strong class="text-charcoal">{questionsAnswered}</strong> questions answered</span>
      )}
      {expert.data.yearsInIndustry && (
        <>
          {questionsAnswered > 0 && <span aria-hidden="true">&middot;</span>}
          <span><strong class="text-charcoal">{expert.data.yearsInIndustry}</strong> years in industry</span>
        </>
      )}
      {expert.data.specialisms.length > 0 && (
        <>
          {(questionsAnswered > 0 || expert.data.yearsInIndustry) && <span aria-hidden="true">&middot;</span>}
          <span>Specialisms: {expert.data.specialisms.join(' &middot; ')}</span>
        </>
      )}
    </div>
  </div>

  <div class="flex shrink-0 flex-col gap-2 md:w-48">
    <a
      href={`#${expert.data.slug}`}
      class="rounded bg-accent px-4 py-2.5 text-center font-semibold text-white no-underline transition-colors hover:bg-accent-dark"
    >
      Visit profile
    </a>
    {telHref && (
      <a
        href={telHref}
        class="flex items-center justify-center gap-1.5 rounded border border-border px-4 py-2.5 text-sm font-semibold text-charcoal no-underline transition-colors hover:border-accent hover:text-accent"
      >
        <svg class="h-3.5 w-3.5 text-brand-red" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"></path>
        </svg>
        {expert.data.phone}
      </a>
    )}
  </div>
</div>
