---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ResourceCard from '../../components/ResourceCard.astro';
import { getTopicStyle } from '../../lib/topicStyles';
import { isStandardReference } from '../../lib/standardsReference';

export async function getStaticPaths() {
  const answers = await getCollection('answers');
  return answers.map((answer) => ({
    params: { slug: answer.data.slug },
    props: { answer },
  }));
}

const { answer } = Astro.props;

const [allAnswers, allCategories, allExperts] = await Promise.all([
  getCollection('answers'),
  getCollection('categories'),
  getCollection('experts'),
]);

const category = allCategories.find((c) => c.data.slug === answer.data.category);
const expert = allExperts.find((e) => e.data.slug === answer.data.answeredBy);

// Only as many related questions as are genuinely linked — not padded out to match any particular count.
const relatedEntries = answer.data.relatedAnswers
  .map((slug) => allAnswers.find((a) => a.data.slug === slug))
  .filter((entry) => entry !== undefined);

const references = answer.data.tags.filter(isStandardReference);
const style = category ? getTopicStyle(category.data.slug) : null;

const updated = answer.data.publishedDate
  ? new Date(answer.data.publishedDate).toLocaleDateString('en-GB', {
      day: 'numeric',
      month: 'short',
      year: 'numeric',
    })
  : null;

const { Content } = await render(answer);
const { Content: ExpertBio } = expert ? await render(expert) : { Content: undefined };

const placeholderPattern = 'bg-[repeating-linear-gradient(45deg,#E4E8E2_0_10px,#EDEFEA_10px_20px)]';
---

<Layout
  title={`${answer.data.question} | Enclosure Answers`}
  description={answer.data.shortAnswer ?? answer.data.question}
>
  <nav class="mb-4 text-[13px] text-muted" aria-label="Breadcrumb">
    <a href="/" class="text-muted no-underline hover:text-accent">Home</a>
    <span class="mx-2">/</span>
    <a href="/faq" class="text-muted no-underline hover:text-accent">Questions / FAQ</a>
    {category && style && (
      <>
        <span class="mx-2">/</span>
        <a href={`/category/${category.data.slug}`} class="text-muted no-underline hover:text-accent">
          {style.shortName}
        </a>
      </>
    )}
    <span class="mx-2">/</span>
    <span class="inline-block max-w-[16rem] truncate align-bottom text-charcoal" aria-current="page">
      {answer.data.shortTitle ?? answer.data.question}
    </span>
  </nav>

  <div class="mb-3 flex flex-wrap items-center gap-x-2 gap-y-1 text-[13px]">
    {category && style && (
      <a
        href={`/category/${category.data.slug}`}
        data-pagefind-filter={`topic:${style.shortName}`}
        class={`rounded-full px-2.5 py-1 font-semibold no-underline hover:underline ${style.colorClass}`}
      >
        {style.shortName}
      </a>
    )}
    {updated && (
      <>
        <span class="text-muted" aria-hidden="true">&middot;</span>
        <span
          class="text-muted"
          data-pagefind-meta={`date:${updated}`}
          data-pagefind-sort={answer.data.publishedDate ? `date:${answer.data.publishedDate.toISOString().slice(0, 10)}` : undefined}
        >
          Updated {updated}
        </span>
      </>
    )}
    {references.length > 0 && (
      <>
        <span class="text-muted" aria-hidden="true">&middot;</span>
        <span class="text-muted">Ref: {references.join(' / ')}</span>
      </>
    )}
  </div>

  <h1 class="mb-8 font-sans text-[28px] font-bold text-charcoal md:text-[32px]">{answer.data.question}</h1>

  <div class="grid gap-8 md:grid-cols-[1fr_300px]">
    <div class="min-w-0">
      <div data-pagefind-body data-pagefind-meta={`title:${answer.data.question}`}>
        {answer.data.shortAnswer && (
          <div class="mb-6 rounded-lg border border-accent/30 bg-lime-50/60 p-5">
            <p class="m-0 mb-2 text-[11px] font-semibold uppercase tracking-wide text-muted">Short answer</p>
            <p class="m-0 text-base text-charcoal">{answer.data.shortAnswer}</p>
          </div>
        )}

        <div class="mb-6 max-w-none text-base text-charcoal [&_p]:mb-4 [&_p:last-child]:mb-0">
          <Content />
        </div>

        {answer.data.keyQuestions.length > 0 && (
          <div class="mb-6">
            <h2 class="mb-3 font-sans text-[19px] font-bold text-charcoal">Start with three questions</h2>
            <ol class="m-0 list-none space-y-3 p-0">
              {answer.data.keyQuestions.map((item, index) => (
                <li class="text-base text-charcoal">
                  <strong>{index + 1}. {item.question}</strong> {item.answer}
                </li>
              ))}
            </ol>
          </div>
        )}

        {answer.data.comparisonTable && (
          <div class="mb-6 overflow-x-auto rounded-lg border border-border">
            <table class="w-full border-collapse text-left text-sm">
              <thead>
                <tr class="bg-background">
                  {answer.data.comparisonTable.columns.map((column) => (
                    <th class="border-b border-border px-4 py-2 font-sans font-semibold text-charcoal">{column}</th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {answer.data.comparisonTable.rows.map((row) => (
                  <tr class="border-b border-border last:border-b-0">
                    {row.map((cell) => (
                      <td class="px-4 py-2 text-muted">{cell}</td>
                    ))}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </div>

      {answer.data.diagramCaption && (
        <div class={`relative mb-6 flex h-40 items-center justify-center overflow-hidden rounded-lg border border-border ${placeholderPattern}`}>
          <span class="rounded bg-white/90 px-2 py-1 font-mono text-[13px] text-muted">
            [ {answer.data.diagramCaption} ]
          </span>
        </div>
      )}

      <div class="mb-6 flex flex-wrap items-center justify-between gap-4 rounded-lg border border-border bg-surface px-5 py-4">
        <div class="flex flex-wrap items-center gap-3">
          <span class="text-sm text-muted">Was this answer helpful?</span>
          <button type="button" class="cursor-not-allowed rounded border border-border px-3 py-1.5 text-sm text-charcoal" disabled>
            &#128077; Yes
          </button>
          <button type="button" class="cursor-not-allowed rounded border border-border px-3 py-1.5 text-sm text-charcoal" disabled>
            &#128078; No
          </button>
        </div>
        <div class="flex items-center gap-2">
          <span class="text-sm text-muted">Share:</span>
          <button
            type="button"
            id="copy-link"
            aria-label="Copy link to this answer"
            class="rounded border border-border p-2 text-charcoal transition-colors hover:border-accent hover:text-accent"
          >
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
              <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
            </svg>
          </button>
          <a
            href={`mailto:?subject=${encodeURIComponent(answer.data.question)}&body=${encodeURIComponent(Astro.url.href)}`}
            aria-label="Share this answer by email"
            class="rounded border border-border p-2 text-charcoal transition-colors hover:border-accent hover:text-accent"
          >
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 4h16v16H4z"></path>
              <path d="m4 6 8 7 8-7"></path>
            </svg>
          </a>
          <a
            href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(Astro.url.href)}`}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Share this answer on LinkedIn"
            class="flex h-8 w-8 items-center justify-center rounded border border-border text-[11px] font-bold text-charcoal transition-colors hover:border-accent hover:text-accent"
          >
            in
          </a>
        </div>
      </div>

      <div class="flex flex-col items-start justify-between gap-4 rounded-lg bg-charcoal p-6 text-white md:flex-row md:items-center">
        <div>
          <p class="m-0 mb-1 font-sans text-lg font-bold">Does your installation not quite fit this answer?</p>
          <p class="m-0 text-sm text-white/80">Ask a follow-up &mdash; we&rsquo;ll reply within one working day.</p>
        </div>
        <a
          href="/contact"
          class="shrink-0 rounded bg-accent px-5 py-2.5 font-semibold text-white no-underline transition-colors hover:bg-accent-dark"
        >
          Ask a follow-up
        </a>
      </div>
    </div>

    <aside class="space-y-6">
      {expert && (
        <div class="rounded-lg border border-border bg-surface p-5">
          <p class="m-0 mb-3 text-[11px] font-semibold uppercase tracking-wide text-muted">Answered by</p>
          <div class="mb-3 flex items-center gap-3">
            <span class={`flex h-14 w-14 shrink-0 items-center justify-center overflow-hidden rounded-full border border-border ${placeholderPattern}`}>
              <span class="rounded bg-white/80 px-1.5 py-0.5 font-mono text-[10px] text-muted">photo</span>
            </span>
            <div data-pagefind-meta={`author:${expert.data.name}, ${expert.data.title}`}>
              <p class="m-0 font-sans text-base font-bold text-charcoal">{expert.data.name}</p>
              <p class="m-0 text-sm text-muted">{expert.data.title}, Spelsberg UK</p>
            </div>
          </div>
          {ExpertBio && (
            <div class="mb-3 text-sm text-muted [&_p]:mb-0">
              <ExpertBio />
            </div>
          )}
          {expert.data.phone && (
            <a
              href={`tel:${expert.data.phone.replace(/[^\d+]/g, '')}`}
              class="mb-3 flex items-center gap-1.5 text-sm font-semibold text-charcoal no-underline hover:text-accent"
            >
              <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"></path>
              </svg>
              {expert.data.phone}
            </a>
          )}
          <a
            href={`/experts#${expert.data.slug}`}
            class="text-sm font-semibold text-accent no-underline hover:underline"
          >
            View profile &amp; all answers &rarr;
          </a>
        </div>
      )}

      {relatedEntries.length > 0 && (
        <div class="overflow-hidden rounded-lg border border-border bg-surface">
          <p class="m-0 border-b border-border bg-background px-4 py-2.5 text-[11px] font-semibold uppercase tracking-wide text-muted">
            Related questions
          </p>
          <ul class="m-0 list-none p-0">
            {relatedEntries.map((entry) => (
              <li class="border-b border-border px-4 py-3 last:border-b-0">
                <a href={`/answer/${entry.data.slug}`} class="text-sm font-semibold text-accent no-underline hover:underline">
                  {entry.data.question}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}

      {style && (
        <ResourceCard
          title={`${style.shortName} selection guide`}
          description="One-page chart, PDF"
          action="Download"
        />
      )}
    </aside>
  </div>
</Layout>

<script>
  document.getElementById('copy-link')?.addEventListener('click', async () => {
    await navigator.clipboard.writeText(window.location.href);
  });
</script>
