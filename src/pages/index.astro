---
// Home page
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import SearchBar from '../components/SearchBar.astro';
import TopicCard from '../components/TopicCard.astro';
import FAQAccordionItem from '../components/FAQAccordionItem.astro';
import ExpertCard from '../components/ExpertCard.astro';
import { getTopicStyle } from '../lib/topicStyles';

const [allAnswers, allCategories, allExperts] = await Promise.all([
  getCollection('answers'),
  getCollection('categories'),
  getCollection('experts'),
]);

allExperts.sort((a, b) => a.data.order - b.data.order);

const expertNames = Object.fromEntries(allExperts.map((expert) => [expert.data.slug, expert.data.name]));
const categoryNameBySlug = Object.fromEntries(allCategories.map((category) => [category.data.slug, category.data.name]));

const topics = allCategories
  .map((category) => ({
    name: category.data.name,
    slug: category.data.slug,
    count: allAnswers.filter((answer) => answer.data.category === category.data.slug).length,
    ...getTopicStyle(category.data.slug),
  }))
  .filter((topic) => topic.count > 0)
  .sort((a, b) => b.count - a.count);

const popularTopics = topics.slice(0, 3);

// No view-count data exists yet, so "most-asked" uses one recent answer per topic as a stand-in.
const featured = topics
  .map((topic) =>
    allAnswers
      .filter((answer) => answer.data.category === topic.slug)
      .sort((a, b) => (b.data.publishedDate?.getTime() ?? 0) - (a.data.publishedDate?.getTime() ?? 0))[0]
  )
  .filter((entry) => entry !== undefined);

const placeholderPattern = 'bg-[repeating-linear-gradient(45deg,#E4E8E2_0_10px,#EDEFEA_10px_20px)]';
---

<Layout
  title="Enclosure Answers | Electrical Enclosure FAQs, Answered by Experts"
  description="100+ real questions from UK engineers, panel builders and contractors — answered by Spelsberg UK's technical team."
>
  <section class="mb-16 grid gap-8 md:grid-cols-[1fr_420px] md:items-center">
    <div>
      <h1 class="mb-4 font-sans text-[28px] font-bold text-charcoal md:text-[38px]">
        Electrical enclosure FAQs, answered by experts
      </h1>
      <p class="mb-6 max-w-xl text-base text-muted">
        100+ real questions from UK engineers, panel builders and contractors &mdash; answered by
        Spelsberg UK&rsquo;s technical team. IP ratings, fire resistance, materials, DIN rail and
        outdoor installation.
      </p>
      <SearchBar placeholder="What do you want to know?" />
      <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2">
        <a
          href="/faq"
          class="rounded border border-border bg-surface px-5 py-2.5 text-sm font-semibold text-charcoal no-underline transition-colors hover:border-accent hover:text-accent"
        >
          Browse all FAQs
        </a>
        <p class="m-0 text-sm text-muted">
          Popular:{' '}
          {popularTopics.map((topic, index) => (
            <>
              {index > 0 && <span aria-hidden="true"> &middot; </span>}
              <a href={`/faq#${topic.slug}`} class="font-semibold text-accent no-underline hover:underline">
                {topic.shortName}
              </a>
            </>
          ))}
        </p>
      </div>
    </div>
    <div class={`relative h-56 overflow-hidden rounded-lg border border-border md:h-72 ${placeholderPattern}`}>
      <span class="absolute bottom-4 left-4 rounded bg-white/90 px-2 py-1 font-mono text-[13px] text-muted">
        [ hero image &mdash; enclosure range / workshop ]
      </span>
    </div>
  </section>

  <section class="mb-16">
    <h2 class="mb-2 font-sans text-[22px] font-bold text-charcoal md:text-[26px]">Browse by topic</h2>
    <p class="mb-6 text-base text-muted">
      Every answer is written by a named Spelsberg UK engineer &mdash; not a forum, not a chatbot.
    </p>
    <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-6">
      {topics.map((topic) => (
        <TopicCard
          code={topic.code}
          name={topic.shortName}
          count={topic.count}
          colorClass={topic.colorClass}
          href={`/faq#${topic.slug}`}
        />
      ))}
    </div>
  </section>

  <section class="mb-16">
    <div class="mb-6 flex items-center justify-between gap-4">
      <h2 class="font-sans text-[22px] font-bold text-charcoal md:text-[26px]">Most-asked questions</h2>
      <a href="/faq" class="shrink-0 text-sm font-semibold text-accent no-underline hover:underline">View all FAQs &rarr;</a>
    </div>
    <div class="space-y-3">
      {featured.map((entry, index) => (
        <FAQAccordionItem
          entry={entry}
          expertName={expertNames[entry.data.answeredBy] ?? entry.data.answeredBy}
          categoryName={categoryNameBySlug[entry.data.category]}
          open={index === 0}
        />
      ))}
    </div>
  </section>

  <section class="mb-8">
    <div class="mb-6 flex items-center justify-between gap-4">
      <div>
        <h2 class="mb-1 font-sans text-[22px] font-bold text-charcoal md:text-[26px]">
          The engineers behind the answers
        </h2>
        <p class="m-0 text-base text-muted">
          Real, named engineers from Spelsberg UK&rsquo;s technical team &mdash; call them directly, no
          call centre.
        </p>
      </div>
      <a href="/experts" class="shrink-0 text-sm font-semibold text-accent no-underline hover:underline">
        Meet all our experts &rarr;
      </a>
    </div>
    <div class="grid gap-6 md:grid-cols-3">
      {allExperts.map((expert) => (
        <ExpertCard expert={expert} href={`/experts#${expert.data.slug}`} />
      ))}
    </div>
  </section>
</Layout>
