---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ContactForm from '../islands/ContactForm.tsx';
import { getInitials } from '../lib/initials';

const allExperts = (await getCollection('experts')).sort((a, b) => a.data.order - b.data.order);

const openingHours = 'Mon–Fri, 8:30–17:00';
const placeholderPattern = 'bg-[repeating-linear-gradient(45deg,#E4E8E2_0_10px,#EDEFEA_10px_20px)]';
---

<Layout
  title="Contact | Enclosure Answers"
  description="Ask Spelsberg UK's engineers a question about electrical enclosures, or find their direct dials."
>
  <nav class="mb-6 text-[13px] text-muted" aria-label="Breadcrumb">
    <a href="/" class="text-muted no-underline hover:text-accent">Home</a>
    <span class="mx-2">/</span>
    <span class="text-charcoal" aria-current="page">Contact</span>
  </nav>

  <section class="mb-10">
    <h1 class="mb-4 font-sans text-[28px] font-bold text-charcoal md:text-[38px]">
      Contact Spelsberg UK / Enclosure Answers
    </h1>
    <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm">
      <a href="tel:+441952605849" class="flex items-center gap-1.5 font-bold text-charcoal no-underline hover:text-accent">
        <svg class="h-4 w-4 text-brand-red" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"></path>
        </svg>
        01952 605 849
      </a>
      <span class="text-muted" aria-hidden="true">&middot;</span>
      <a
        href="mailto:info@enclosureanswers.com"
        class="flex items-center gap-1.5 font-semibold text-accent no-underline hover:underline"
      >
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 4h16v16H4z"></path>
          <path d="m4 6 8 7 8-7"></path>
        </svg>
        info@enclosureanswers.com
      </a>
      <span class="text-muted" aria-hidden="true">&middot;</span>
      <span class="text-muted">{openingHours}</span>
    </div>
  </section>

  <div class="grid gap-8 md:grid-cols-[1fr_360px]">
    <div class="rounded-lg border border-border bg-surface p-6 md:p-8">
      <h2 class="mb-2 font-sans text-[22px] font-bold text-charcoal">Ask a question</h2>
      <p class="mb-6 max-w-xl text-sm text-muted">
        Keep it practical &mdash; the more you tell us about the installation, the better the answer. We
        reply within one working day, free of charge.
      </p>
      <ContactForm client:load />
    </div>

    <div class="space-y-6">
      <div class={`relative h-40 overflow-hidden rounded-lg border border-border ${placeholderPattern}`}>
        <span class="absolute inset-0 flex items-center justify-center">
          <span class="rounded bg-white/90 px-2 py-1 font-mono text-[13px] text-muted">
            [ Google map embed &mdash; Telford ]
          </span>
        </span>
      </div>

      <div class="rounded-lg border border-border bg-surface p-5">
        <p class="m-0 font-sans text-base font-bold text-charcoal">Spelsberg els UK Ltd</p>
        <p class="m-0 mt-1 text-sm text-muted">
          Unit 1B, Queensway Business Park,<br />
          Hadley Park East, Telford,<br />
          Shropshire TF3 3BJ
        </p>
        <p class="m-0 mt-2 text-sm text-muted">Opening hours: {openingHours}</p>
      </div>

      <div class="rounded-lg border border-border bg-surface p-5">
        <p class="m-0 font-sans text-base font-bold text-charcoal">Speak to the right expert</p>
        <p class="mb-3 text-sm text-muted">Direct dials &mdash; no call centre.</p>
        <ul class="m-0 list-none space-y-3 p-0">
          {allExperts.map((expert) => (
            <li class="flex items-center justify-between gap-3">
              <div class="flex min-w-0 items-center gap-3">
                <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-background text-xs font-bold text-muted">
                  {getInitials(expert.data.name)}
                </span>
                <div class="min-w-0">
                  <p class="m-0 truncate text-sm font-bold text-charcoal">{expert.data.name}</p>
                  <p class="m-0 truncate text-[13px] text-muted">{expert.data.specialisms.join(', ')}</p>
                </div>
              </div>
              {expert.data.phone && (
                <a
                  href={`tel:${expert.data.phone.replace(/[^\d+]/g, '')}`}
                  class="shrink-0 text-sm font-semibold text-accent no-underline hover:underline"
                >
                  {expert.data.phone}
                </a>
              )}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</Layout>
